clc;
clear all;
close all;

x=input('enter the x sequences');
h=input('enter the h sequences');

N=max(length(x),length(h));
x=[x zeros(1,N-length(x))];
h=[h zeros(1,N-length(h))];

X=fft(x);
H=fft(h);
Y=X.*H;
y=ifft(Y);
y=real(y);

disp('circular convolution');
disp(y);

figure;
subplot(3,1,1);
stem(0:length(x)-1,x,'filled');
xlabel('n');
ylabel('amplitude');
title('input x');
grid on;

subplot(3,1,2);
stem(0:length(h)-1,h,'filled');
xlabel('n');
ylabel('amplitude');
title('input h');
grid on;

subplot(3,1,3);
stem(0:length(y)-1,y,'filled');
xlabel('n');
ylabel('amplitude');
title('input y');
grid on;
